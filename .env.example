SECRET_KEY=replace-with-a-generated-secret

# For app in the container
DB_NAME=vane_and_watt
DB_USER=postgres
DB_PASSWORD=replace-with-a-password
DB_HOST=vane_and_watt_db
DB_PORT=5432
TEST_DB_NAME=test_vane_and_watt

# For the Postgres container
POSTGRES_DB=vane_and_watt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-password

REDIS_URL=redis://vane_and_watt_redis:6379/0
CELERY_BROKER_URL=redis://vane_and_watt_redis:6379/0
CELERY_RESULT_BACKEND=redis://vane_and_watt_redis:6379/0

ACCESS_TOKEN_VALIDITY=30
REFRESH_TOKEN_VALIDITY=7

EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Vane & Watt <your-address@gmail.com>